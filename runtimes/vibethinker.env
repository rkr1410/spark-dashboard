# Runtime identity
COMPOSE_PROJECT_NAME=spark-vibethinker
CONTAINER_NAME=vibethinker
IMAGE=vllm-node-mxfp4
MODEL_ID=WeiboAI/VibeThinker-3B
PORT=8001

# Hugging Face cache
HF_CACHE_HOST=/home/pafau/.cache/huggingface
HF_CACHE_CONTAINER=/cache/huggingface
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=0

# Human notes for dashboard/config tracking
PROVIDER=vllm
DISPLAY_NAME=VibeThinker 3B
MODEL_FAMILY=qwen2.5-derived
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.15
CTX_FIT=
KV_MEMORY_GIB=
KV_CACHE_TOKENS=
NOTES=No tool-call or reasoning parser configured by default. Model card says it was not trained for tool calling or agent workflows.

# vLLM model args
VLLM_ARGS=--gpu-memory-utilization 0.15 --max-model-len 32768
