# Runtime identity
COMPOSE_PROJECT_NAME=spark-gptoss
CONTAINER_NAME=gptoss
IMAGE=vllm-node-mxfp4
MODEL_ID=openai/gpt-oss-120b
PORT=8000

# Hugging Face cache
HF_CACHE_HOST=/home/pafau/.cache/huggingface
HF_CACHE_CONTAINER=/cache/huggingface
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=1

# Human notes for dashboard/config tracking
PROVIDER=vllm
DISPLAY_NAME=gpt-oss 120B
MODEL_FAMILY=gpt-oss
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.665
CTX_FIT=1.71
KV_MEMORY_GIB=4.09
KV_CACHE_TOKENS=119008
NOTES=Primary GPT-OSS runtime. Parser flags are model-specific and intentional.

# vLLM model args
VLLM_ARGS=--tool-call-parser openai --reasoning-parser openai_gptoss --enable-auto-tool-choice --gpu-memory-utilization 0.665 --enable-prefix-caching --load-format fastsafetensors --quantization mxfp4 --mxfp4-backend CUTLASS --mxfp4-layers moe,qkv,o,lm_head --attention-backend FLASHINFER --kv-cache-dtype fp8 --max-num-batched-tokens 8192 --max-model-len 131072
