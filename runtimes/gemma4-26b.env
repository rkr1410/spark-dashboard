# Runtime identity
COMPOSE_PROJECT_NAME=spark-gemma4-26b
CONTAINER_NAME=gemma4-26b
IMAGE=vllm/vllm-openai:gemma
MODEL_ID=google/gemma-4-26b-a4b-it
PORT=8002

# Hugging Face cache
HF_CACHE_HOST=/home/pafau/.cache/huggingface
HF_CACHE_CONTAINER=/cache/huggingface
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=0

# vLLM runtime env
VLLM_USE_V2_MODEL_RUNNER=1

# Human notes for dashboard/config tracking
PROVIDER=vllm
DISPLAY_NAME=Gemma 4 26B A4B IT
MODEL_FAMILY=gemma4
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.5
CTX_FIT=
KV_MEMORY_GIB=
KV_CACHE_TOKENS=
NOTES=Plain transformer Gemma 4 profile. Use the Gemma vLLM image because vllm-node-mxfp4 does not recognize model_type=gemma4.

# vLLM model args
VLLM_ARGS=--trust-remote-code --enable-auto-tool-choice --tool-call-parser gemma4 --reasoning-parser gemma4 --gpu-memory-utilization 0.5 --max-model-len 131072
