# Runtime identity
COMPOSE_PROJECT_NAME=spark-diffusiongemma
CONTAINER_NAME=diffusiongemma
IMAGE=vllm/vllm-openai:gemma
MODEL_ID=nvidia/diffusiongemma-26B-A4B-it-NVFP4
PORT=8003

# Hugging Face cache
HF_CACHE_HOST=/home/pafau/.cache/huggingface
HF_CACHE_CONTAINER=/cache/huggingface
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=0

# vLLM runtime env
VLLM_USE_V2_MODEL_RUNNER=1

# Human notes for dashboard/config tracking
PROVIDER=vllm
DISPLAY_NAME=DiffusionGemma 26B A4B NVFP4
MODEL_FAMILY=diffusiongemma
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.5
CTX_FIT=
KV_MEMORY_GIB=
KV_CACHE_TOKENS=
NOTES=NVIDIA NVFP4 diffusion checkpoint. Keep separate from plain Gemma 4; switch HF_HUB_OFFLINE to 1 after the model is cached.

# vLLM model args
VLLM_ARGS=--trust-remote-code --max-num-seqs 4 --attention-backend TRITON_ATTN --enable-auto-tool-choice --tool-call-parser gemma4 --reasoning-parser gemma4 --override-generation-config={"max_new_tokens":null} --default-chat-template-kwargs={"enable_thinking":true} --gpu-memory-utilization 0.5 --max-model-len 262144
